# Copied to .env on install if .env is missing. Every value has a working dev default.
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
# SQLite file, relative to prisma/schema.prisma. For Postgres: postgresql://user:pass@host:5432/fieldwise
DATABASE_URL=file:./dev.db
# Change in production. At least 32 characters.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Browser origin allowed by CORS
WEB_ORIGIN=http://localhost:5173
# Optional: data.gov.in key for live Agmarknet mandi prices. Leave empty to use the simulator.
AGMARKNET_API_KEY=
# Folder for uploaded photos, relative to apps/api
UPLOAD_DIR=uploads
# Leaf photo analyser. Only colour-heuristic exists today; see src/services/analysers.
LEAF_ANALYSER=colour-heuristic
