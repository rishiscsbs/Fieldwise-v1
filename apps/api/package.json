{
  "name": "@fieldwise/api",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "postinstall": "node scripts/ensure-env.mjs && prisma generate",
    "db:setup": "node scripts/ensure-env.mjs && prisma db push --skip-generate && tsx prisma/seed.ts --if-empty",
    "db:reset": "node scripts/ensure-env.mjs && prisma db push --force-reset --skip-generate && tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^10.1.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^10.2.7",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^5.2.6",
    "@fieldwise/shared": "2.0.0",
    "@prisma/client": "5.22.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "socket.io": "^4.8.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "pino-pretty": "^11.3.0",
    "prisma": "5.22.0",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.19.2",
    "vitest": "^2.1.9"
  }
}
